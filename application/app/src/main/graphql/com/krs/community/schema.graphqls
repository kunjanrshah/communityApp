type Query {
  getFamilyMembers(head_id: Float!): [UserDTO!]!

  usersByDateRange(fromDate: String!, toDate: String!, page: Float!, limit: Float!): [UserDTO!]!

  getInactiveUsers(input: GetInactiveUsersInput!): [UserDTO!]!

  getSharedProfiles(userId: Int!): [UserDTO!]!

  getSharingProfiles(userId: Int!): [UserDTO!]!

  getContactList(input: GetContactListInput!): GetContactListResponse!

    getCities(date: DateInputDto): GetMastersResponseDTO!

    getStates(date: DateInputDto): GetMastersResponseDTO!

    getBusinessCategories(date: DateInputDto): GetMastersResponseDTO!

    getCommittees(date: DateInputDto): GetMastersResponseDTO!

    getDesignations(date: DateInputDto): GetMastersResponseDTO!

    getEducations(date: DateInputDto): GetMastersResponseDTO!

    getRelations(date: DateInputDto): GetMastersResponseDTO!

    getGotras(date: DateInputDto): GetMastersResponseDTO!

    getSubCasts(date: DateInputDto): GetMastersResponseDTO!

    getCitiesByState(stateId: Int!, date: DateInputDto, subCommunityId: Int): CityResponseDto!

  getStatistics(input: StatisticsInputDto!): StatisticsResponseDto!

  reminders: [Reminder!]!

  reminder(id: Int!): Reminder!

  getUserFiles(user_id: Int!): [UploadModel!]!

  smartSearch(input: SearchInput!): SearchResult!

  smartFilter(input: SearchRequestDTO!): SearchResult!

  nearByUsers(filter: GetNearbyUsersInput!): SearchResult!

  isAppVersionExists(version: Float!): Boolean!

    getMastersCounts: MastersCountResponseDTO!

    getSubCommunities(date: DateInputDto): GetMastersResponseDTO!

    getLocalCommunities(date: DateInputDto, subCommunityId: Int!): GetMastersResponseDTO!
}

