<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/iv_cancel"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_margin="10dp"
            android:background="@drawable/left_arrow" />

        <TextView
            android:layout_width="match_parent"
            android:text="Committee"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/montserrat_semibold"
            android:textSize="18sp"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/filter"
            android:layout_width="20dp"
            android:layout_marginRight="20dp"
            android:background="@drawable/controls"
            android:layout_height="20dp" />

    </LinearLayout>

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/flexbox_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:alignContent="stretch"
        app:alignItems="stretch"
        app:flexWrap="wrap">

        <LinearLayout
            android:id="@+id/ll_region"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_margin="3dp"
            android:gravity="center_vertical"
            android:background="@drawable/round_corner_white"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_region"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:text="Region name"
                android:background="@null"
                android:singleLine="true"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/img_region_close"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_gravity="right|center_vertical"
                android:background="@drawable/ic_cancel_pop_item"
                android:padding="5dp" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_duration"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_margin="3dp"
            android:gravity="center_vertical"
            android:background="@drawable/round_corner_white"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Duration"
                android:layout_marginLeft="10dp"
                android:background="@null"
                android:singleLine="true"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/img_duration_close"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_gravity="right|center_vertical"
                android:background="@drawable/ic_cancel_pop_item"
                android:padding="5dp" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_committee"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_margin="5dp"
            android:gravity="center_vertical"
            android:background="@drawable/round_corner_white"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/txt_committee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Committee name"
                android:layout_marginLeft="10dp"
                android:background="@null"
                android:singleLine="true"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/img_committee_close"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_gravity="right|center_vertical"
                android:background="@drawable/ic_cancel_pop_item"
                android:padding="5dp" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_designation"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_margin="5dp"
            android:gravity="center_vertical"
            android:background="@drawable/round_corner_white"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/txt_designation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Designation"
                android:layout_marginLeft="10dp"
                android:background="@null"
                android:singleLine="true"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/img_designation_close"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_gravity="right|center_vertical"
                android:background="@drawable/ic_cancel_pop_item"
                android:padding="5dp" />


        </LinearLayout>


    </com.google.android.flexbox.FlexboxLayout>



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listCommittee"
        android:layout_width="match_parent"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_height="match_parent" />


</LinearLayout>