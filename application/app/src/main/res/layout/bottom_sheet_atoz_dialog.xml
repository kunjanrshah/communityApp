        android:layout_height="match_parent"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="50dp"
        android:background="#ffffff"
        android:shrinkColumns="*"
        android:stretchColumns="*">

