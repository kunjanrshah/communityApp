<?xml version="1.0" encoding="utf-8"?>

<com.chauthai.swipereveallayout.SwipeRevealLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:layout_marginLeft="14dp"
    android:layout_marginRight="14dp"
    app:dragEdge="right"
    android:background="@drawable/round_corner_itemlist"
    app:mode="same_level">

    <FrameLayout
        android:id="@+id/delete_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">

        <TextView
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:background="@drawable/right_corner"
            android:textColor="@android:color/white"
            android:text="Delete"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/front_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:padding="16dp"
            android:id="@+id/card_view_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/round_corner_profile"
                        android:src="@drawable/user" />

                    <com.nightonke.boommenu.BoomMenuButton
                        android:id="@+id/bmb1"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        app:bmb_buttonEnum="textInsideCircle"
                        app:bmb_buttonPlaceEnum="buttonPlace_sc_6_1"
                        app:bmb_inList="true"
                        android:layout_marginLeft="-8dp"
                        android:layout_marginTop="-5dp"
                        app:bmb_piecePlaceEnum="piecePlace_dot_6_1" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_name"
                            android:singleLine="true"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Kunjan Patel"
                            android:fontFamily="@font/montserrat_semibold"
                            android:textSize="16sp"    />

                        <TextView
                            android:id="@+id/tv_subtext"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_regular"
                            android:text="Maninagar, Ahmedabad"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="5dp"
                            android:background="@color/colorGray" />


                        <LinearLayout
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:background="@drawable/ic_email" />

                            <TextView
                                android:id="@+id/tv_email"
                                android:singleLine="true"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginLeft="5dp"
                                android:fontFamily="@font/montserrat_regular"
                                android:text="kunjanshah@gmail.com"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:background="@drawable/phone" />

                            <TextView
                                android:id="@+id/tv_mobile"
                                android:singleLine="true"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginLeft="5dp"
                                android:text="9825450261"
                                android:fontFamily="@font/montserrat_regular"
                                android:textColor="@color/com_facebook_blue"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tv_update"
                                android:gravity="right"
                                android:fontFamily="@font/montserrat_light"
                                android:textSize="12sp"
                                android:layout_width="match_parent"
                                android:text="12-12-2019"
                                android:layout_height="wrap_content"/>

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>


        </LinearLayout>
    </FrameLayout>

</com.chauthai.swipereveallayout.SwipeRevealLayout>


