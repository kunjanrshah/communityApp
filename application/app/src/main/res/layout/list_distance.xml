<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view_list"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/round_corner_itemlist"
    android:orientation="vertical"
    android:padding="16dp"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:contentPadding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:clickable="true"
                    android:id="@+id/icon_container1"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/icon_back1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillAfter="false"
                        android:fillEnabled="false">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/bg_circle" />

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:src="@drawable/ic_done_white_24dp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/icon_front1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillAfter="false"
                        android:fillEnabled="false">

                        <ImageView
                            android:id="@+id/icon_profile1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:adjustViewBounds="true"/>

                        <TextView
                            android:id="@+id/icon_text1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:textColor="@android:color/white"
                            android:textSize="22sp" />
                    </RelativeLayout>

                </RelativeLayout>

                <ImageView
                    android:id="@+id/iv_gender"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginRight="3dp"
                    android:background="@drawable/male" />

                <com.nightonke.boommenu.BoomMenuButton
                    android:id="@+id/bmb1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:bmb_buttonEnum="textInsideCircle"
                    android:layout_marginTop="-10dp"
                    android:layout_marginLeft="-8dp"
                    app:bmb_piecePlaceEnum="piecePlace_dot_6_1"
                    app:bmb_buttonPlaceEnum="buttonPlace_sc_6_1"
                    app:bmb_inList="true"/>

                <ImageView
                    android:id="@+id/icon_star"
                    android:layout_width="25dp"
                    android:layout_marginRight="3dp"
                    android:layout_marginTop="-15dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_height="25dp"
                    android:tint="@color/icon_tint_normal" />


                <TextView
                    android:id="@+id/tv_home"
                    android:visibility="gone"
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="Home"
                    android:textColor="@color/colorPrimary" />

                <TextView
                    android:id="@+id/tv_office"
                    android:visibility="gone"
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="Office"
                    android:textColor="@color/colorPrimary" />

                <TextView
                    android:id="@+id/tv_user"
                    android:visibility="gone"
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="User"
                    android:textColor="@color/colorPrimary" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_name"
                            android:singleLine="true"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_semibold"
                            android:text="Kunjan Patel"
                            android:textSize="18sp" />

                        <TextView
                            android:fontFamily="@font/montserrat_medium"
                            android:id="@+id/tv_area"
                            android:singleLine="true"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Maninagar, Ahmedabad"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:id="@+id/ll_mobile"
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:gravity="center_vertical"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_mobile"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:background="@drawable/phone" />

                            <TextView
                                android:id="@+id/tv_mobile"
                                android:singleLine="true"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginLeft="5dp"
                                android:text="9825450261"
                                android:fontFamily="@font/montserrat_semibold"
                                android:textColor="@color/com_facebook_blue"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_role"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/round_corner_blue"
                        android:fontFamily="@font/montserrat_semibold"
                        android:gravity="center"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="Member"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="5dp"
                    android:alpha="1"
                    android:visibility="gone"
                    android:layout_marginTop="5dp"
                    android:background="@color/colorGray" />

                <LinearLayout
                    android:id="@+id/ll_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="5dp"
                    android:layout_marginLeft="10dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_email"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:background="@drawable/ic_email" />

                    <TextView
                        android:id="@+id/tv_email"
                        android:singleLine="true"
                        android:autoLink="email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="5dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:text="kunjanshah@gmail.com"
                        android:textSize="14sp" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginLeft="5dp"
                    android:alpha="1"
                    android:background="@color/colorGray" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:visibility="gone"
                            android:id="@+id/ll_home"
                            android:layout_width="match_parent"
                            android:orientation="horizontal"
                            android:layout_marginTop="10dp"
                            android:layout_marginLeft="10dp"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_gravity="center"
                                android:background="@drawable/location"
                                android:layout_height="15dp" />

                            <TextView
                                android:id="@+id/tv_home_dist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:fontFamily="@font/montserrat_semibold"
                                android:text="12.3KM"
                                android:textSize="14sp" />

                        </LinearLayout>
                        <LinearLayout
                            android:visibility="gone"
                            android:id="@+id/ll_office"
                            android:layout_width="match_parent"
                            android:orientation="horizontal"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:layout_marginLeft="10dp"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_gravity="center"
                                android:background="@drawable/location"
                                android:layout_height="15dp" />
                            <TextView
                                android:id="@+id/tv_office_dist"
                                android:layout_width="wrap_content"
                                android:text="12.3KM"
                                android:textSize="14sp"
                                android:layout_marginLeft="3dp"
                                android:fontFamily="@font/montserrat_semibold"
                                android:layout_height="wrap_content" />

                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/ll_user"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:orientation="horizontal"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:layout_marginLeft="10dp"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_gravity="center"
                                android:background="@drawable/location"
                                android:layout_height="15dp" />
                            <TextView
                                android:id="@+id/tv_user_dist"
                                android:layout_width="wrap_content"
                                android:text="12.3KM"
                                android:textSize="14sp"
                                android:layout_marginLeft="5dp"
                                android:fontFamily="@font/montserrat_semibold"
                                android:layout_height="wrap_content" />

                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_update"
                        android:gravity="right"
                        android:fontFamily="@font/montserrat_light"
                        android:textSize="12sp"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:text="12-12-2019"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>