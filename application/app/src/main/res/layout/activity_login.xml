<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_login"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBG"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="30dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_back"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginLeft="10dp"
            android:visibility="invisible"
            android:background="@drawable/left_arrow"
            android:padding="5dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/img_header_logo"
                android:layout_width="250dp"
                android:layout_height="23dp"
                android:background="@drawable/app_text_title" />
        </LinearLayout>

        <ImageView
            android:layout_width="30dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="60dp"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_login_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_now"
            android:fontFamily="@font/montserrat_semibold"
            android:textColor="@color/black"
            android:textSize="25sp"        />

        <TextView
            android:id="@+id/txt_pls_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/please_login_to_continue_using_our_app"
            android:textSize="14sp" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_weight="0.35"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/login_with"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/login_with"
            android:fontFamily="@font/montserrat_semibold"
            android:textSize="14sp"   />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="1">

            <Button
                android:id="@+id/btn_mobile"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="0.40"
                android:background="@color/colorPrimaryDark"
                android:text="@string/_mobile"
                android:fontFamily="@font/montserrat_semibold"
                android:textColor="@color/mdtp_white"   />

            <Button
                android:id="@+id/btn_email"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginLeft="50dp"
                android:layout_weight="0.40"
                android:background="@drawable/border"
                android:text="@string/email"
                android:fontFamily="@font/montserrat_semibold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/rl_spinner"
                    android:layout_width="100dp"
                    android:layout_height="45dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/border"
                    android:gravity="center">

                    <Spinner
                        android:id="@+id/spinnerCountries"
                        style="@style/Widget.AppCompat.DropDownItem.Spinner"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content" />
                </RelativeLayout>

                <EditText
                    android:id="@+id/edt_username"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/border"
                    android:drawableStart="@drawable/icon"
                    android:drawablePadding="10dp"
                    android:hint="@string/enter_mobile_no"
                    android:fontFamily="@font/montserrat_regular"
                    android:inputType="phone|textNoSuggestions"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:singleLine="true" />


            </LinearLayout>

            <EditText
                android:id="@+id/edt_pass"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/border"
                android:drawableStart="@drawable/lock"
                android:drawableEnd="@drawable/pwd_hide"
                android:drawablePadding="10dp"
                android:hint="@string/password"
                android:fontFamily="@font/montserrat_regular"
                android:inputType="textWebPassword"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/edt_cpass"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/border"
                android:drawableStart="@drawable/lock"
                android:drawableEnd="@drawable/pwd_hide"
                android:drawablePadding="10dp"
                android:hint="@string/hint_conform_password"
                android:inputType="textWebPassword"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:fontFamily="@font/montserrat_regular"
                android:singleLine="true"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_forgot_pass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_forgot_password"
                android:fontFamily="@font/montserrat_semibold"    />

            <TextView
                android:id="@+id/txt_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:fontFamily="@font/montserrat_regular"
                android:visibility="gone" />

        </LinearLayout>


        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:background="@color/colorPrimaryDark"
            android:text="@string/login"
            android:fontFamily="@font/montserrat_semibold"
            android:textColor="@color/mdtp_white"
            android:textSize="18sp"     />

        <TextView
            android:id="@+id/txt_do_you_have"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/montserrat_regular"
            android:layout_marginTop="10dp"
            android:text="@string/do_you_have_an_account_register_now" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.65"
        android:background="@color/colorPrimaryDark"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <View
                android:layout_width="50dp"
                android:layout_height="2dp"
                android:layout_gravity="center_vertical"
                android:background="@color/mdtp_white" />

            <TextView
                android:id="@+id/txt_or_login_with"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:text="@string/or_login_with"
                android:fontFamily="@font/montserrat_semibold"
                android:textColor="@color/mdtp_white"
                 />

            <View
                android:layout_width="50dp"
                android:layout_height="2dp"
                android:layout_gravity="center_vertical"
                android:background="@color/mdtp_white" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_login_fb"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/facebook" />

            <ImageView
                android:id="@+id/img_login_google"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="center"
                android:layout_marginLeft="30dp"
                android:background="@drawable/google" />

            <com.google.android.gms.common.SignInButton
                android:id="@+id/btn_login_google"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/google"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:visibility="gone" />


        </LinearLayout>
    </LinearLayout>


</LinearLayout>