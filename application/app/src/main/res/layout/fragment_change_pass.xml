<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/ll_parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_gray"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_lan_cancel"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_margin="10dp"
            android:background="@drawable/left_arrow" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Change PIN"
            android:textColor="@color/light_gray"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/round_corner_white"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat_semibold"
                        android:text="Current PIN"
                        android:textColor="#272727"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_forgot"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:fontFamily="@font/montserrat_semibold"
                        android:text="Forgot PIN?"
                        android:textColor="@color/colorGray"
                        android:textSize="10sp"
                         />


                </LinearLayout>

                <EditText
                    android:id="@+id/edt_curr"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="5dp"
                    android:inputType="textPassword"
                    android:paddingRight="20dp"
                    android:drawableEnd="@drawable/hide_pass"
                    android:fontFamily="@font/montserrat_semibold"
                    android:background="@drawable/round_corner_white"
                    android:hint="Enter Current PIN"
                    android:textColorHint="@color/color_mid_light_gray"
                    android:paddingLeft="20dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="New PIN"
                    android:textColor="#272727"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edt_new"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:inputType="textPassword"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/montserrat_semibold"
                    android:background="@drawable/round_corner_white"
                    android:hint="Enter New PIN"
                    android:paddingRight="20dp"
                    android:drawableEnd="@drawable/hide_pass"
                    android:textColorHint="@color/color_mid_light_gray"
                    android:paddingLeft="20dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="Confirm PIN"
                    android:textColor="#272727"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edt_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="5dp"
                    android:paddingRight="20dp"
                    android:inputType="textPassword"
                    android:drawableEnd="@drawable/hide_pass"
                    android:textColorHint="@color/color_mid_light_gray"
                    android:background="@drawable/round_corner_white"
                    android:hint="Enter Confirm PIN"
                    android:fontFamily="@font/montserrat_semibold"
                    android:paddingLeft="20dp" />

            </LinearLayout>


            <Button
                android:id="@+id/btn_update"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:background="@drawable/round_corner_primary"
                android:text="Update PIN"
                android:fontFamily="@font/montserrat_semibold"
                android:textColor="@color/white" />


        </LinearLayout>


    </LinearLayout>

</layout>

