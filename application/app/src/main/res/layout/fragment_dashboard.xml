<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="40dp"
        android:isScrollContainer="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/edt_search"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="15dp"
                    android:background="@drawable/home_search_bar_bg"
                    android:drawableStart="@drawable/home_search"
                    android:drawableEnd="@drawable/voice"
                    android:drawablePadding="10dp"
                    android:focusable="false"
                    android:hint="Search Here..."
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingLeft="15dp"
                    android:paddingRight="15dp"
                    android:singleLine="true"
                    tools:ignore="UnusedAttribute" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_marginBottom="3dp"
                    android:layout_height="wrap_content">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:text="News &amp; Events"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_semibold" />

                    <TextView
                        android:id="@+id/tv_all_news"
                        android:layout_width="wrap_content"
                        android:text="View All"
                        android:textSize="14sp"
                        android:layout_marginRight="10dp"
                        android:textColor="@color/black1"
                        android:fontFamily="@font/montserrat_medium"
                        android:layout_gravity="bottom"
                        android:layout_height="wrap_content" />
                   <!-- <ImageView
                        android:id="@+id/iv_all_news"
                        android:layout_width="18dp"
                        android:layout_marginRight="10dp"
                        android:layout_gravity="bottom"
                        android:padding="5dp"
                        android:background="@drawable/view_all_48"
                        android:layout_height="18dp" />-->

                </LinearLayout>

                <com.smarteist.autoimageslider.SliderLayout
                    android:id="@+id/imageSlider"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_alignParentTop="true"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat_semibold"
                        android:text="Favorites"
                        android:textColor="@color/colorPrimary"
                        android:textSize="14sp" />


                    <TextView
                        android:id="@+id/tv_all_favorites"
                        android:layout_width="wrap_content"
                        android:text="View All"
                        android:textSize="14sp"
                        android:layout_marginRight="10dp"
                        android:textColor="@color/black1"
                        android:fontFamily="@font/montserrat_medium"
                        android:layout_gravity="bottom"
                        android:layout_height="wrap_content" />

                    <!--<ImageView
                        android:id="@+id/iv_all_favorites"
                        android:layout_width="18dp"
                        android:layout_marginRight="10dp"
                        android:layout_gravity="bottom"
                        android:padding="5dp"
                        android:background="@drawable/view_all_48"
                        android:layout_height="18dp" />-->

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lstFavProfile"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="15dp"
                    android:layout_height="wrap_content" />

                <!--<LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/border_0_corder"
                    android:elevation="3dp"
                    android:orientation="vertical">


                </LinearLayout>-->


                <com.krs.community.utils.ExpandableHeightGridView
                    android:id="@+id/grid_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:drawSelectorOnTop="true"
                    android:gravity="center"
                    android:horizontalSpacing="2dp"
                    android:isScrollContainer="false"
                    android:numColumns="4"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="20dp" />

            </LinearLayout>


        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>



