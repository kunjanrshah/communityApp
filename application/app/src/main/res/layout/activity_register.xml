<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="registerviewmodel"
            type="com.krs.community.viewmodel.RegisterViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/root_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorBG"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="5dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/img_back"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/left_arrow"
                    android:padding="5dp"
                    android:visibility="invisible"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/img_header"
                        android:layout_width="250dp"
                        android:layout_height="24dp"
                        android:background="@drawable/logo_with_text_app"
                        android:visibility="gone"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:id="@+id/ll_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/img_header_logo"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:background="@drawable/ic_app"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="15dp"
                            android:fontFamily="@font/montserrat_semibold"
                            android:text="@string/app_name"
                            android:textAllCaps="true"
                            android:textColor="@color/colorTree"
                            android:textSize="20sp" />

                    </LinearLayout>

                </LinearLayout>

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="15dp"
                    android:orientation="vertical">


                    <!--<TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:fontFamily="@font/montserrat_semibold"
                        android:gravity="end"
                        android:layout_marginEnd="10dp"
                        android:text="@string/register_now"
                        android:textSize="20sp" />-->

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/img_profile"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginStart="20dp"
                            android:src="@drawable/man_reg" />

                        <ImageView
                            android:id="@+id/img_cancel"
                            android:layout_width="25dip"
                            android:layout_height="25dip"
                            android:layout_marginStart="75dp"
                            android:padding="5dp"
                            android:src="@drawable/cancel_popup"
                            tools:ignore="ContentDescription" />


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_marginEnd="10dp"
                            android:fontFamily="@font/montserrat_semibold"
                            android:gravity="end"
                            android:text="@string/register_now"
                            android:textSize="20sp" />

                    </FrameLayout>


                    <EditText
                        android:id="@+id/edt_head_name"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/border"
                        android:digits="@string/only_chars"
                        android:drawableStart="@drawable/user_name"
                        android:drawablePadding="10dp"
                        android:fontFamily="@font/montserrat_regular"
                        android:hint="@string/hint_name"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:nextFocusDown="@+id/edt_father_name"
                        android:paddingStart="10dp"
                        android:paddingEnd="0dp"
                        android:singleLine="true"
                        android:text="@={registerviewmodel.fname}"
                        android:textSize="16sp"
                        tools:ignore="Autofill" />

                    <EditText
                        android:id="@+id/edt_father_name"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/border"
                        android:digits="@string/only_chars"
                        android:drawableStart="@drawable/user_name"
                        android:drawablePadding="10dp"
                        android:fontFamily="@font/montserrat_regular"
                        android:hint="@string/fathername"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:nextFocusDown="@+id/spinnerLname"
                        android:paddingStart="10dp"
                        android:paddingEnd="0dp"
                        android:singleLine="true"
                        android:text="@={registerviewmodel.father}"
                        android:textSize="16sp"
                        tools:ignore="Autofill" />


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/name_gradient_spinner"
                        android:gravity="center">

                        <com.krs.community.jrspinner.JRSpinner
                            android:id="@+id/spinnerLname"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="30dp"
                            android:background="@null"
                            android:fontFamily="@font/montserrat_regular"
                            android:hint="@string/last_nameDetails"
                            android:imeOptions="actionNext"
                            android:nextFocusDown="@+id/edt_email_id"
                            android:paddingRight="15dp"
                            android:singleLine="true"
                            android:textColor="@color/black1"
                            android:textSize="16sp"
                            app:backgroundTint="@color/colorPrimary"
                            app:jrs_icon_tint="@color/colorPrimary"
                            app:jrs_multiple="false"
                            app:jrs_title="@string/SelctLatname" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/gender_gradient_spinner"
                        android:gravity="center">

                        <com.krs.community.jrspinner.JRSpinner
                            android:id="@+id/spinnerGender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="30dp"
                            android:background="@null"
                            android:fontFamily="@font/montserrat_regular"
                            android:hint="@string/SelectYourGender"
                            android:imeOptions="actionNext"
                            android:nextFocusDown="@+id/edt_email_id"
                            android:paddingRight="15dp"
                            android:singleLine="true"
                            android:textColor="@color/black1"
                            android:textSize="16sp"
                            app:backgroundTint="@color/colorPrimary"
                            app:jrs_icon_tint="@color/colorPrimary"
                            app:jrs_multiple="false"
                            app:jrs_title="@string/selecgender" />

                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/calendar_gradient_spinner"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/txt_bdate"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/montserrat_regular"
                                android:gravity="center_vertical"
                                android:hint="Birth Date"
                                android:paddingLeft="30dp"
                                android:singleLine="true"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="right|center"
                                android:fontFamily="@font/montserrat_light"
                                android:paddingRight="10dp"
                                android:text="DD/MM/YYYY"
                                android:textSize="12sp" />

                        </FrameLayout>

                    </LinearLayout>


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:layout_gravity="center|bottom"
                        android:layout_marginTop="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/marital_gradient_spinner"
                        android:gravity="center|bottom"
                        android:textAlignment="center">

                        <com.krs.community.jrspinner.JRSpinner
                            android:id="@+id/sp_marital"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="30dp"
                            android:background="@null"
                            android:fontFamily="@font/montserrat_regular"
                            android:hint="@string/select_marital"
                            android:imeOptions="actionNext"
                            android:paddingRight="10dp"
                            android:singleLine="true"
                            android:textColor="@color/black1"
                            app:backgroundTint="@color/colorPrimary"
                            app:jrs_icon_tint="@color/colorPrimary"
                            app:jrs_multiple="false"
                            app:jrs_title="@string/selectMarial" />
                    </RelativeLayout>

                    <EditText
                        android:id="@+id/edt_email_id"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/border"
                        android:drawableStart="@drawable/mail"
                        android:drawablePadding="15dp"
                        android:fontFamily="@font/montserrat_regular"
                        android:hint="@string/hint_email"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:nextFocusDown="@+id/edt_mobile"
                        android:paddingStart="10dp"
                        android:paddingEnd="0dp"
                        android:singleLine="true"
                        android:text="@={registerviewmodel.email}"
                        android:textSize="16sp"
                        tools:ignore="Autofill" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <RelativeLayout
                            android:layout_width="130dp"
                            android:layout_height="50dp"
                            android:layout_gravity="center"
                            android:background="@drawable/country_gradient_spinner"
                            android:visibility="gone">

                            <com.krs.community.jrspinner.JRSpinner
                                android:id="@+id/spinnerCountries"
                                style="@style/Widget.AppCompat.DropDownItem.Spinner"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="20dp"
                                android:background="@null"
                                android:fontFamily="@font/montserrat_regular"
                                android:hint="@string/code"
                                android:singleLine="true"
                                app:jrs_multiple="false" />
                        </RelativeLayout>

                        <EditText
                            android:id="@+id/edt_mobile"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/register_field_height"
                            android:background="@drawable/border"
                            android:drawableStart="@drawable/ic_phone"
                            android:drawablePadding="15dp"
                            android:fontFamily="@font/montserrat_regular"
                            android:hint="@string/hint_mobile"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="10"
                            android:nextFocusDown="@+id/edt_password"
                            android:paddingStart="10dp"
                            android:paddingEnd="0dp"
                            android:singleLine="true"
                            android:text="@={registerviewmodel.mobile}"
                            android:textSize="16sp"
                            tools:ignore="Autofill" />
                    </LinearLayout>

                    <com.krs.community.utils.ChromaHashView
                        android:id="@+id/edt_password"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/border"
                        android:digits="@string/only_numbers"
                        android:drawableStart="@drawable/lock"
                        android:drawablePadding="15dp"
                        android:fontFamily="@font/montserrat_regular"
                        android:hint="@string/hint_password"
                        android:imeOptions="actionNext"
                        android:nextFocusDown="@+id/edt_cpassword"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:singleLine="true"
                        android:text="@={registerviewmodel.pass}"
                        android:textSize="16sp"
                        tools:ignore="Autofill" />

                    <com.krs.community.utils.ChromaHashView
                        android:id="@+id/edt_cpassword"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/border"
                        android:digits="@string/only_numbers"
                        android:drawableStart="@drawable/lock"
                        android:drawablePadding="15dp"
                        android:fontFamily="@font/montserrat_regular"
                        android:hint="@string/hint_conform_password"
                        android:imeOptions="actionNext"
                        android:nextFocusDown="@+id/spinnerStates"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:singleLine="true"
                        android:text="@={registerviewmodel.cpass}"
                        android:textSize="16sp"
                        tools:ignore="Autofill" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/state_gradient_spinner">

                        <com.krs.community.jrspinner.JRSpinner
                            android:id="@+id/spinnerStates"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/register_field_height"
                            android:layout_marginStart="30dp"
                            android:background="@null"
                            android:fontFamily="@font/montserrat_regular"
                            android:hint="@string/select_state"
                            android:imeOptions="actionNext"
                            android:nextFocusDown="@+id/spinnerCities"
                            android:paddingRight="15dp"
                            android:singleLine="true"
                            android:textColor="@color/black1"
                            android:textSize="16sp"
                            app:backgroundTint="@color/colorPrimary"
                            app:jrs_icon_tint="@color/colorPrimary"
                            app:jrs_multiple="false"
                            app:jrs_title="@string/satetList" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/gradient_spinner">

                        <com.krs.community.jrspinner.JRSpinner
                            android:id="@+id/spinnerCities"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/register_field_height"
                            android:layout_marginStart="30dp"
                            android:background="@null"
                            android:fontFamily="@font/montserrat_regular"
                            android:hint="@string/select_city"
                            android:imeOptions="actionNext"
                            android:nextFocusDown="@+id/spinnerNative"
                            android:paddingRight="15dp"
                            android:singleLine="true"
                            android:textColor="@color/black1"
                            android:textSize="16sp"
                            app:backgroundTint="@color/colorPrimary"
                            app:jrs_icon_tint="@color/colorPrimary"
                            app:jrs_multiple="false"
                            app:jrs_title="@string/cityList" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rl_native"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/gradient_spinner">

                        <com.krs.community.jrspinner.JRSpinner
                            android:id="@+id/spinnerNative"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/register_field_height"
                            android:layout_marginStart="30dp"
                            android:background="@null"
                            android:fontFamily="@font/montserrat_regular"
                            android:hint="@string/select_native"
                            android:imeOptions="actionNext"
                            android:nextFocusDown="@+id/edt_address"
                            android:paddingRight="15dp"
                            android:singleLine="true"
                            android:textColor="@color/black1"
                            android:textSize="16sp"
                            app:backgroundTint="@color/colorPrimary"
                            app:jrs_icon_tint="@color/colorPrimary"
                            app:jrs_multiple="false"
                            app:jrs_title="@string/nativeList" />

                    </RelativeLayout>

                    <EditText
                        android:id="@+id/edt_address"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/border"
                        android:drawableStart="@drawable/home_address"
                        android:drawablePadding="15dp"
                        android:fontFamily="@font/montserrat_regular"
                        android:hint="@string/hint_address"
                        android:imeOptions="actionNext"
                        android:nextFocusDown="@+id/spinnerSub"
                        android:paddingStart="10dp"
                        android:singleLine="true"
                        android:inputType="textMultiLine|textCapWords"
                        android:text="@={registerviewmodel.address}"
                        android:textSize="16sp"
                        tools:ignore="Autofill" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/community_gradient_spinner">

                        <com.krs.community.jrspinner.JRSpinner
                            android:id="@+id/spinnerSub"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/register_field_height"
                            android:layout_marginStart="15dp"
                            android:background="@null"
                            android:fontFamily="@font/montserrat_regular"
                            android:hint="@string/select_sub_community"
                            android:imeOptions="actionNext"
                            android:nextFocusDown="@+id/spinnerLocal"
                            android:paddingLeft="15dp"
                            android:paddingRight="15dp"
                            android:singleLine="true"
                            android:textColor="@color/black1"
                            android:textSize="16sp"
                            app:backgroundTint="@color/colorPrimary"
                            app:jrs_icon_tint="@color/colorPrimary"
                            app:jrs_multiple="false"
                            app:jrs_title="@string/sCommunity" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/community_gradient_spinner">


                        <com.krs.community.jrspinner.JRSpinner
                            android:id="@+id/spinnerLocal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/register_field_height"
                            android:layout_marginStart="15dp"
                            android:background="@null"
                            android:fontFamily="@font/montserrat_regular"
                            android:hint="@string/select_local_community"
                            android:imeOptions="actionDone"
                            android:nextFocusDown="@+id/btn_register"
                            android:paddingLeft="15dp"
                            android:paddingRight="15dp"
                            android:singleLine="true"
                            android:textColor="@color/black1"
                            android:textSize="16sp"
                            app:backgroundTint="@color/colorPrimary"
                            app:jrs_icon_tint="@color/colorPrimary"
                            app:jrs_multiple="false"
                            app:jrs_title="@string/localCom" />

                    </RelativeLayout>

                    <TextView
                        android:id="@+id/txt_how_register"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:fontFamily="@font/montserrat_regular"
                        android:gravity="center_horizontal"
                        android:text="@string/how_to_register"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btn_register"
                        android:layout_width="200dp"
                        android:layout_height="45dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_margin="5dp"
                        android:background="@drawable/btn_registration_selection"
                        android:fontFamily="@font/montserrat_semibold"
                        android:gravity="center"
                        android:text="@string/register"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txt_already"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="70dp"
                        android:fontFamily="@font/montserrat_regular"
                        android:gravity="center_horizontal"
                        android:text="@string/already_have_a_account_sign_in"
                        android:textColor="@color/colorPrimary"
                        android:textSize="16sp" />

                </LinearLayout>
            </ScrollView>

        </LinearLayout>

        <com.krs.community.utils.MovableFloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="40dp"
            android:backgroundTint="@android:color/white"
            android:scaleType="center"
            android:src="@drawable/btn_help_selection"
            app:borderWidth="0dp"
            app:elevation="6dp"
            app:fabCustomSize="40dp"
            app:fabSize="normal"
            app:maxImageSize="40dp" />


    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>