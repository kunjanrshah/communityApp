<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="registerviewmodel"
            type="com.krs.community.viewmodel.RegisterViewModel" />

    </data>


<LinearLayout
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBG"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="5dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_back"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/left_arrow"
            android:padding="5dp"
            android:visibility="invisible"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/img_header_logo"
                android:layout_width="250dp"
                android:layout_height="23dp"
                tools:ignore="ContentDescription"
                android:background="@drawable/app_text_title" />
        </LinearLayout>

        <ImageView
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

            <LinearLayout
                android:layout_marginLeft="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/img_profile"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginStart="20dp"
                        android:src="@drawable/man_reg" />

                    <ImageView
                        android:id="@+id/img_cancel"
                        android:layout_width="25dip"
                        android:layout_height="25dip"
                        android:layout_marginStart="80dp"
                        android:padding="5dp"
                        android:src="@drawable/cancel"
                        tools:ignore="ContentDescription" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:fontFamily="@font/montserrat_semibold"
                        android:gravity="end"
                        android:layout_marginEnd="10dp"
                        android:text="@string/register_now"
                        android:textSize="20sp" />

                </FrameLayout>


                <EditText
                    android:id="@+id/edt_head_name"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/register_field_height"
                    android:nextFocusDown="@+id/spinnerLname"
                    android:imeOptions="actionNext"
                    android:layout_marginTop="10dp"
                    android:digits= "@string/only_chars"
                    android:background="@drawable/border"
                    android:drawableStart="@drawable/man_user"
                    android:drawablePadding="10dp"
                    android:text="@={registerviewmodel.fname}"
                    android:fontFamily="@font/montserrat_regular"
                    android:hint="@string/hint_name"
                    android:inputType="textCapSentences"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:singleLine="true"
                    tools:ignore="Autofill" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/register_field_height"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:background="@drawable/name_gradient_spinner">

                    <com.krs.community.jrspinner.JRSpinner
                        android:id="@+id/spinnerLname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:hint="Select Last Name"
                        android:background="@null"
                        android:nextFocusDown="@+id/edt_email_id"
                        android:imeOptions="actionNext"
                        android:layout_marginLeft="25dp"
                        android:paddingRight="15dp"
                        android:textColor="@color/black1"
                        app:backgroundTint="@color/colorPrimary"
                        app:jrs_icon_tint="@color/colorPrimary"
                        app:jrs_multiple="false"
                        app:jrs_title="Select Last Name" />

                </RelativeLayout>


                <EditText
                    android:id="@+id/edt_email_id"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/register_field_height"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/border"
                    android:drawableStart="@drawable/close_envelope"
                    android:drawablePadding="10dp"
                    android:text="@={registerviewmodel.email}"
                    android:fontFamily="@font/montserrat_regular"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:singleLine="true"
                    android:nextFocusDown="@+id/edt_mobile"
                    android:imeOptions="actionNext"
                    tools:ignore="Autofill" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:visibility="gone"
                        android:layout_width="130dp"
                        android:layout_height="50dp"
                        android:background="@drawable/country_gradient_spinner"
                        android:layout_gravity="center">

                        <com.krs.community.jrspinner.JRSpinner
                            android:id="@+id/spinnerCountries"
                            app:jrs_multiple="false"
                            android:singleLine="true"
                            android:layout_marginLeft="20dp"
                            android:hint="Code"
                            android:background="@null"
                            style="@style/Widget.AppCompat.DropDownItem.Spinner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </RelativeLayout>

                    <EditText
                        android:id="@+id/edt_mobile"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/border"
                        android:drawableStart="@drawable/icon"
                        android:drawablePadding="10dp"
                        android:fontFamily="@font/montserrat_regular"
                        android:hint="@string/hint_mobile"
                        android:text="@={registerviewmodel.mobile}"
                        android:inputType="number"
                        android:maxLength="10"
                        android:paddingEnd="0dp"
                        android:paddingStart="10dp"
                        android:singleLine="true"
                        android:nextFocusDown="@+id/edt_password"
                        android:imeOptions="actionNext"
                        tools:ignore="Autofill" />
                </LinearLayout>

                <EditText
                    android:id="@+id/edt_password"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/register_field_height"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/border"
                    android:drawableStart="@drawable/lock"
                    android:drawableEnd="@drawable/pwd_hide"
                    android:drawablePadding="10dp"
                    android:text="@={registerviewmodel.pass}"
                    android:fontFamily="@font/montserrat_regular"
                    android:hint="@string/hint_password"
                    android:inputType="textPassword"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:singleLine="true"
                    android:nextFocusDown="@+id/edt_cpassword"
                    android:imeOptions="actionNext"
                    tools:ignore="Autofill" />

                <EditText
                    tools:ignore="Autofill"
                    android:id="@+id/edt_cpassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/register_field_height"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/border"
                    android:drawableStart="@drawable/lock"
                    android:drawableEnd="@drawable/pwd_hide"
                    android:drawablePadding="10dp"
                    android:text="@={registerviewmodel.cpass}"
                    android:fontFamily="@font/montserrat_regular"
                    android:hint="@string/hint_conform_password"
                    android:inputType="textPassword"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:nextFocusDown="@+id/spinnerStates"
                    android:imeOptions="actionNext"
                    android:singleLine="true"                   />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/register_field_height"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/state_gradient_spinner">

                    <com.krs.community.jrspinner.JRSpinner
                        android:id="@+id/spinnerStates"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:singleLine="true"
                        android:hint="Select State"
                        android:background="@null"
                        android:paddingLeft="30dp"
                        android:paddingRight="15dp"
                        android:textColor="@color/black1"
                        app:backgroundTint="@color/colorPrimary"
                        app:jrs_icon_tint="@color/colorPrimary"
                        app:jrs_multiple="false"
                        android:nextFocusDown="@+id/spinnerCities"
                        android:imeOptions="actionNext"
                        app:jrs_title="State List" />

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/register_field_height"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/gradient_spinner">

                    <com.krs.community.jrspinner.JRSpinner
                        android:id="@+id/spinnerCities"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:singleLine="true"
                        android:hint="Select City"
                        android:background="@null"
                        android:paddingLeft="30dp"
                        android:paddingRight="15dp"
                        android:textColor="@color/black1"
                        app:backgroundTint="@color/colorPrimary"
                        app:jrs_icon_tint="@color/colorPrimary"
                        app:jrs_multiple="false"
                        android:nextFocusDown="@+id/edt_address"
                        android:imeOptions="actionNext"
                        app:jrs_title="City List" />


                </RelativeLayout>



                <EditText
                    tools:ignore="Autofill"
                    android:id="@+id/edt_address"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/border"
                    android:drawableStart="@drawable/home_address"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:hint="@string/hint_address"
                    android:text="@={registerviewmodel.address}"
                    android:inputType="textCapSentences"
                    android:paddingEnd="0dp"
                    android:paddingStart="10dp"
                    android:nextFocusDown="@+id/spinnerSub"
                    android:imeOptions="actionNext"
                    android:singleLine="true" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/register_field_height"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/community_gradient_spinner">

                    <com.krs.community.jrspinner.JRSpinner
                        android:id="@+id/spinnerSub"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:singleLine="true"
                        android:layout_marginLeft="25dp"
                        android:hint="Select Sub Community"
                        android:background="@null"
                        android:paddingLeft="15dp"
                        android:paddingRight="15dp"
                        android:textColor="@color/black1"
                        app:backgroundTint="@color/colorPrimary"
                        app:jrs_icon_tint="@color/colorPrimary"
                        app:jrs_multiple="false"
                        android:nextFocusDown="@+id/spinnerLocal"
                        android:imeOptions="actionNext"
                        app:jrs_title="Sub Community" />

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/register_field_height"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/community_gradient_spinner">


                    <com.krs.community.jrspinner.JRSpinner
                        android:id="@+id/spinnerLocal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/register_field_height"
                        android:singleLine="true"
                        android:layout_marginLeft="25dp"
                        android:hint="Select Local Community"
                        android:background="@null"
                        android:paddingLeft="15dp"
                        android:paddingRight="15dp"

                        android:textColor="@color/black1"
                        app:backgroundTint="@color/colorPrimary"
                        app:jrs_icon_tint="@color/colorPrimary"
                        app:jrs_multiple="false"
                        android:nextFocusDown="@+id/btn_register"
                        android:imeOptions="actionDone"
                        app:jrs_title="Local Community" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/txt_how_register"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center_horizontal"
                    android:text="@string/how_to_register"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_register"
                    android:layout_width="200dp"
                    android:layout_height="45dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_margin="5dp"
                    android:background="@drawable/btn_registration"
                    android:fontFamily="@font/montserrat_semibold"
                    android:gravity="center"
                    android:text="@string/register"
                    android:textColor="@color/mdtp_white" />

                <TextView
                    android:id="@+id/txt_already"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="70dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center_horizontal"
                    android:text="@string/already_have_a_account_sign_in"
                    android:textSize="16sp" />

            </LinearLayout>
    </ScrollView>

</LinearLayout>
</layout>