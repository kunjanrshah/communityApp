<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_nearby_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="15dp"
        android:background="@drawable/round_bottom_corner_colorprimary"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/img_cancel"
                android:layout_width="20dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/left_arrow_white"
                android:layout_height="20dp" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:text="Search by Distance"
                android:textColor="@color/white"
                android:fontFamily="@font/montserrat_semibold"
                android:textSize="16sp"
                android:layout_marginLeft="15dp"
                android:layout_gravity="center"
                android:layout_height="wrap_content" />

        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:paddingTop="10dp"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Enter Distance(Km)"
            android:textColor="@color/white"
            android:textSize="18sp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbtnHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/white"
                android:checked="true"
                android:text="Home"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="@color/white"
                />

            <RadioButton
                android:id="@+id/rbtnOffice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/white"
                android:text="Office"
                android:checked="false"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="@color/white"
                />

            <RadioButton
                android:id="@+id/rbtnUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/white"
                android:text="User"
                android:checked="false"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="@color/white"
                />

            <RadioButton
                android:id="@+id/rbtnAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/white"
                android:text="All"
                android:checked="false"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="@color/white"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtKm"
                android:layout_width="150dp"
                android:layout_height="45dp"
                android:background="@drawable/border_dark_primary"
                android:hint="Enter Km"
                android:imeOptions="actionDone"
                android:paddingLeft="10dp"
                android:digits="0123456789"
                android:inputType="number"
                android:maxLength="4"
                android:text="25"
                android:textSize="26sp"
                android:singleLine="true"
                android:fontFamily="@font/montserrat_semibold"
                android:textColor="@color/white"
                android:gravity="center"
                android:textColorHint="@color/colorPrimary" />

            <Button
                android:fontFamily="@font/montserrat_semibold"
                android:id="@+id/btnSearch"
                android:layout_width="150dp"
                android:layout_height="45dp"
                android:layout_marginLeft="20dp"
                android:background="@drawable/border_bg_color_primary"
                android:text="Search Now"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:visibility="gone"
        android:id="@+id/tv_total"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:fontFamily="@font/montserrat_semibold"
        android:layout_height="wrap_content"/>

</LinearLayout>
