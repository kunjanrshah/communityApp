<!--                app:data_type="_integer"-->
<!--                app:gap="10"-->
<!--                app:left_thumb_color="#808080"-->
<!--                app:left_thumb_color_pressed="#696969"-->
<!--                app:max_value="100"-->
<!--                app:min_value="0"-->
<!--                app:right_thumb_color="#808080"-->
<!--                app:right_thumb_color_pressed="#696969" />-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textMin1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="@string/age_0"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textMax1"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_medium"
                    android:gravity="right"
                    android:text="@string/age_100"
                    android:textSize="16sp" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>