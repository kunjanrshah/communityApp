<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:background="@drawable/rounded_bottom_corner"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/edt_head_name"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@drawable/border"
                android:hint="Family head Name"
                android:paddingLeft="10dp" />

            <EditText
                android:id="@+id/edt_member_name"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/border"
                android:hint="Family Member Name"
                android:paddingLeft="10dp" />

            <com.jaredrummler.materialspinner.MaterialSpinner
                android:id="@+id/sp_surname"
                android:layout_marginTop="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_top_corner"
                android:text="Surname" />

            <com.jaredrummler.materialspinner.MaterialSpinner
                android:id="@+id/sp_samaj"
                android:layout_marginTop="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_top_corner"
                android:text="Regin/Samaj" />

            <com.jaredrummler.materialspinner.MaterialSpinner
                android:id="@+id/sp_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Gender" />

            <com.jaredrummler.materialspinner.MaterialSpinner
                android:id="@+id/sp_marital"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Marital Status" />

            <com.jaredrummler.materialspinner.MaterialSpinner
                android:id="@+id/sp_native"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Native" />

            <com.jaredrummler.materialspinner.MaterialSpinner
                android:id="@+id/sp_city"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="City" />

            <com.crystal.crystalrangeseekbar.widgets.CrystalRangeSeekbar
                android:id="@+id/rangeSeekbar"
                android:layout_marginTop="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:corner_radius="10"
                app:min_value="0"
                app:max_value="100"
                app:gap="10"
                app:bar_color="#C0C0C0"
                app:bar_highlight_color="#A9A9A9"
                app:left_thumb_color="#808080"
                app:right_thumb_color="#808080"
                app:left_thumb_color_pressed="#696969"
                app:right_thumb_color_pressed="#696969"
                app:data_type="_integer"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" >
                <TextView
                    android:id="@+id/textMin1"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:text="Age 0"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/textMax1"
                    android:layout_width="100dp"
                    android:text="Age 100"
                    android:gravity="right"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>