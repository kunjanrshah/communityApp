<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

<LinearLayout android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/border"
    android:padding="10dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:paddingBottom="15dp"
            android:layout_marginRight="15dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Professional"
                android:fontFamily="@font/montserrat_semibold"
                android:textColor="@color/colorPrimary"
                android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_logo"
                android:layout_width="120dp"
                android:layout_marginRight="5dp"
                android:background="@drawable/logo"
                android:layout_height="80dp"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="-5dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Company Name"
                    android:fontFamily="@font/montserrat_semibold" />

                <EditText
                    android:id="@+id/edt_com_name"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:paddingLeft="5dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:background="@drawable/border_color_gray"
                    android:singleLine="true" />

            </LinearLayout>

        </LinearLayout>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="Work Category" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_gravity="center|bottom"
                    android:layout_weight="1"
                    android:background="@drawable/border"
                    android:gravity="center|bottom"
                    android:textAlignment="center">

                    <com.krs.community.jrspinner.JRSpinner
                        android:id="@+id/sp_main_cat"
                        app:backgroundTint="@color/colorPrimary"
                        app:jrs_icon_tint="@color/colorPrimary"
                        app:jrs_multiple="false"
                        app:jrs_title="Select Work Category"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="10dp"
                        android:background="@null"
                        android:fontFamily="@font/montserrat_regular"
                        android:hint="Select"
                        android:imeOptions="actionNext"
                        android:nextFocusDown="@+id/fname"
                        android:paddingRight="10dp"
                        android:singleLine="true"
                        android:textColor="@color/black1" />
                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="Work Sub Category" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_gravity="center|bottom"
                    android:layout_weight="1"
                    android:background="@drawable/border"
                    android:gravity="center|bottom"
                    android:textAlignment="center">

                    <com.krs.community.jrspinner.JRSpinner
                        android:id="@+id/sp_sub_cat"
                        app:backgroundTint="@color/colorPrimary"
                        app:jrs_icon_tint="@color/colorPrimary"
                        app:jrs_multiple="false"
                        app:jrs_title="Select Work Sub Category"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="10dp"
                        android:background="@null"
                        android:fontFamily="@font/montserrat_regular"
                        android:hint="Select"
                        android:imeOptions="actionNext"
                        android:nextFocusDown="@+id/fname"
                        android:paddingRight="10dp"
                        android:singleLine="true"
                        android:textColor="@color/black1" />
                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="Occupation" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_gravity="center|bottom"
                    android:layout_weight="1"
                    android:background="@drawable/border"
                    android:gravity="center|bottom"
                    android:textAlignment="center">

                    <com.krs.community.jrspinner.JRSpinner
                        android:id="@+id/sp_occupation"
                        app:backgroundTint="@color/colorPrimary"
                        app:jrs_icon_tint="@color/colorPrimary"
                        app:jrs_multiple="false"
                        app:jrs_title="Select Work Sub Category"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="10dp"
                        android:background="@null"
                        android:fontFamily="@font/montserrat_regular"
                        android:hint="Select"
                        android:imeOptions="actionNext"
                        android:nextFocusDown="@+id/fname"
                        android:paddingRight="10dp"
                        android:singleLine="true"
                        android:textColor="@color/black1" />
                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Website URL"
                    android:fontFamily="@font/montserrat_semibold"    />

                <EditText
                    android:id="@+id/edt_url"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:paddingLeft="5dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:background="@drawable/border_color_gray"
                    android:singleLine="true" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Work Detail"
                    android:fontFamily="@font/montserrat_semibold" />

                <EditText
                    android:id="@+id/edt_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_color_gray"
                    android:padding="5dp"
                    android:inputType="textMultiLine"
                    android:lines="2"
                    android:gravity="top|left"
                    android:maxLines="2"
                    android:minLines="2"
                    android:fontFamily="@font/montserrat_regular"
                    android:scrollbars="vertical"
                    android:singleLine="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Work Address"
                    android:fontFamily="@font/montserrat_semibold" />

                <EditText
                    android:id="@+id/edt_addr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_color_gray"
                    android:padding="5dp"
                    android:inputType="textMultiLine"
                    android:lines="2"
                    android:gravity="top|left"
                    android:maxLines="2"
                    android:minLines="2"
                    android:fontFamily="@font/montserrat_regular"
                    android:scrollbars="vertical"
                    android:singleLine="true" />

            </LinearLayout>


        </LinearLayout>

    </ScrollView>

</LinearLayout>

</layout>