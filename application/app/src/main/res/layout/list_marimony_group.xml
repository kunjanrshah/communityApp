<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivChildIcon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_launcher" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="5dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChildName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kunjan Shah"
                android:textSize="14dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChildFatherName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rajendra Shah"
                android:textSize="14dp" />

            <TextView
                android:id="@+id/tvChildMotherName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shraddha ben"
                android:textSize="14dp" />

                <TextView
                    android:id="@+id/tvChildCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ahmedabd"
                    android:textSize="14dp" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
        <ImageView
            android:id="@+id/imgChildGender"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="3dp"
            android:background="@drawable/boy"
            />

        <ImageView
            android:id="@+id/imgChildShare"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginTop="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/share_icon"
            android:focusable="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">



        <TextView
            android:id="@+id/tvNudge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="5dp"
            android:text="ROU"
            android:textSize="16dp" />

        <ImageView
            android:id="@+id/img_home_loc"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/house" />


        <ImageView
            android:id="@+id/imgSync"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/clock"
            android:focusable="false" />



        <TextView
            android:id="@+id/tvUpdatedTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:text="Updated: "
            android:textColor="@android:color/black"
            android:textSize="12dp" />
    </LinearLayout>

</LinearLayout>