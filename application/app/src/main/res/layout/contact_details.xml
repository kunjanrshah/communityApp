<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:background="@drawable/round_bottom_corner"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/edt_email"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:singleLine="true"
                android:textSize="14sp"
                android:inputType="textEmailAddress"
                android:fontFamily="@font/montserrat_regular"
                android:background="@drawable/border"
                android:hint="Email Address"
                android:paddingLeft="10dp" />

            <EditText
                android:singleLine="true"
                android:id="@+id/edt_mobile"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:textSize="14sp"
                android:inputType="number"
                android:fontFamily="@font/montserrat_regular"
                android:background="@drawable/border"
                android:hint="Mobile Number"
                android:paddingLeft="10dp" />

            <EditText
                android:id="@+id/edt_local_add"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/border"
                android:hint="Local Address"
                android:textSize="14sp"
                android:fontFamily="@font/montserrat_regular"
                android:singleLine="true"
                android:paddingLeft="10dp" />


            <EditText
                android:id="@+id/edt_permanent_add"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:singleLine="true"
                android:layout_marginTop="10dp"
                android:textSize="14sp"
                android:fontFamily="@font/montserrat_regular"
                android:background="@drawable/border"
                android:hint="Permanent Address"
                android:paddingLeft="10dp" />

            <EditText
                android:id="@+id/edt_pin_code"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/border"
                android:hint="PinCode"
                android:inputType="number"
                android:maxLength="6"
                android:digits="0123456789"
                android:textSize="14sp"
                android:fontFamily="@font/montserrat_regular"
                android:singleLine="true"
                android:paddingLeft="10dp" />

            <EditText
                android:id="@+id/edt_area"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:textSize="14sp"
                android:fontFamily="@font/montserrat_regular"
                android:background="@drawable/border"
                android:hint="Area"
                android:singleLine="true"
                android:paddingLeft="10dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_gravity="center|bottom"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:background="@drawable/border"
                android:gravity="center|bottom"
                android:textAlignment="center">

                <com.krs.community.jrspinner.JRSpinner
                    android:id="@+id/sp_state"
                    app:backgroundTint="@color/colorPrimary"
                    app:jrs_icon_tint="@color/colorPrimary"
                    app:jrs_multiple="false"
                    app:jrs_title="Select State"
                    android:textSize="14sp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:background="@null"
                    android:fontFamily="@font/montserrat_regular"
                    android:hint="Select State"
                    android:imeOptions="actionNext"
                    android:nextFocusDown="@+id/sp_city"
                    android:paddingRight="10dp"
                    android:singleLine="true"
                    android:textColor="@color/black1" />
            </RelativeLayout>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>