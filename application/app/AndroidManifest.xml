<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.app.ipoguru">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />-->

    <application
        android:name=".IPOGURU"
        android:allowBackup="true"
        android:icon="@mipmap/ipogur"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ipogur"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".activity.MainActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activity.InformationActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activity.SplashScreenActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.TrackerActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.FaqActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.WhatIpoActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.AboutActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.IpoProcessActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.FeedbackActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.HowToApplyActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.GrayMarketActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.AllotmentStatusActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.GreyPremiumCompanyDetailsActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activity.ReviewActivity"
            android:screenOrientation="portrait" />

        <meta-data
            android:name="io.fabric.ApiKey"
            android:value="a13bd71dd19ab718370f9cc149abe8da97364a6c" />

        <!-- Firebase Notifications -->
        <service android:name=".NotificationService.MyFirebaseMessagingService">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service android:name=".NotificationService.MyFirebaseInstanceIDService">
            <intent-filter>
                <action android:name="com.google.firebase.INSTANCE_ID_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-6775764516742640~3501174198" />
    </application>

</manifest>