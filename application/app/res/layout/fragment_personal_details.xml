<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/border"
        android:orientation="vertical"
        android:padding="10dp">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:orientation="vertical"
                android:paddingBottom="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="horizontal"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_semibold"
                            android:text="@string/personalDetail"
                            android:textColor="@color/colorPrimary"
                            android:textSize="18sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_weight="1"
                            android:gravity="right">

                            <CheckBox
                                android:id="@+id/chk_is_donor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:focusable="true"
                                android:layout_gravity="center"
                                android:fontFamily="@font/montserrat_medium"
                                android:text="@string/blood_donorDetail" />

                        </LinearLayout>


                    </LinearLayout>



                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_semibold"
                                android:text="@string/roleDetails" />

                            <TextView
                                android:id="@+id/edt_role"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:textSize="20sp"
                                android:paddingLeft="10dp"
                                android:gravity="center_vertical"
                                android:background="@drawable/border_color_gray"
                                android:fontFamily="@font/montserrat_regular"
                                android:singleLine="true" />

                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_semibold"
                                android:text="@string/nativeDetails" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_gravity="center|bottom"
                                android:layout_weight="1"
                                android:background="@drawable/border"
                                android:gravity="center|bottom"
                                android:textAlignment="center">

                                <com.krs.community.jrspinner.JRSpinner
                                    android:id="@+id/sp_native"
                                    app:backgroundTint="@color/colorPrimary"
                                    app:jrs_icon_tint="@color/colorPrimary"
                                    app:jrs_multiple="false"
                                    app:jrs_title="Select Native"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="10dp"
                                    android:background="@null"
                                    android:fontFamily="@font/montserrat_regular"
                                    android:hint="@string/selectDetails"
                                    android:imeOptions="actionNext"
                                    android:nextFocusDown="@+id/fname"
                                    android:paddingRight="10dp"
                                    android:singleLine="true"
                                    android:textColor="@color/black1" />
                            </RelativeLayout>

                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_marginTop="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_semibold"
                                android:text="@string/birth_dateDetail" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:orientation="horizontal"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:id="@+id/txt_bdate"
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:paddingLeft="10dp"
                                    android:gravity="center_vertical"
                                    android:textSize="20sp"
                                    android:layout_weight="1"
                                    android:background="@drawable/border_color_gray"
                                    android:fontFamily="@font/montserrat_regular"
                                    android:singleLine="true" />


                            </LinearLayout>


                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_regular"
                            android:text="DD/MM/YYYY"
                            android:textSize="10sp" />

                    </LinearLayout>


                    <LinearLayout
                        android:layout_marginLeft="10dp"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_gravity="center_vertical"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/montserrat_semibold"
                                    android:text="@string/expire_dateDetails" />

                                <CheckBox
                                    android:id="@+id/chkExpired"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:checked="false"
                                    android:fontFamily="@font/montserrat_regular" />

                            </LinearLayout>


                            <TextView
                                android:id="@+id/txt_expire"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:clickable="false"
                                android:paddingLeft="10dp"
                                android:gravity="center_vertical"
                                android:textSize="20sp"
                                android:background="@drawable/border_color_gray"
                                android:fontFamily="@font/montserrat_regular"
                                android:singleLine="true" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_regular"
                            android:text="DD/MM/YYYY"
                            android:textSize="10sp" />

                    </LinearLayout>



                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_semibold"
                            android:text="@string/blood_groupDetails" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_gravity="center|bottom"
                            android:layout_weight="1"
                            android:background="@drawable/border"
                            android:gravity="center|bottom"
                            android:textAlignment="center">

                            <com.krs.community.jrspinner.JRSpinner
                                android:id="@+id/sp_bg"
                                app:backgroundTint="@color/colorPrimary"
                                app:jrs_icon_tint="@color/colorPrimary"
                                app:jrs_multiple="false"
                                app:jrs_title="Select Blood Group"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="10dp"
                                android:background="@null"
                                android:fontFamily="@font/montserrat_regular"
                                android:hint="@string/selectDetails"
                                android:imeOptions="actionNext"
                                android:nextFocusDown="@+id/fname"
                                android:paddingRight="10dp"
                                android:singleLine="true"
                                android:textColor="@color/black1" />
                        </RelativeLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_marginLeft="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_semibold"
                            android:text="@string/gotraDetails" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_gravity="center|bottom"
                            android:layout_weight="1"
                            android:background="@drawable/border"
                            android:gravity="center|bottom"
                            android:textAlignment="center">

                            <com.krs.community.jrspinner.JRSpinner
                                android:id="@+id/sp_gotra"
                                app:backgroundTint="@color/colorPrimary"
                                app:jrs_icon_tint="@color/colorPrimary"
                                app:jrs_multiple="false"
                                app:jrs_title="Select Gotra"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="10dp"
                                android:background="@null"
                                android:fontFamily="@font/montserrat_regular"
                                android:hint="@string/selectDetails"
                                android:imeOptions="actionNext"
                                android:nextFocusDown="@+id/fname"
                                android:paddingRight="10dp"
                                android:singleLine="true"
                                android:textColor="@color/black1" />
                        </RelativeLayout>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_semibold"
                            android:text="@string/educationDetails" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_gravity="center|bottom"
                            android:layout_weight="1"
                            android:background="@drawable/border"
                            android:gravity="center|bottom"
                            android:textAlignment="center">

                            <com.krs.community.jrspinner.JRSpinner
                                android:id="@+id/sp_education"
                                app:backgroundTint="@color/colorPrimary"
                                app:jrs_icon_tint="@color/colorPrimary"
                                app:jrs_multiple="false"
                                app:jrs_title="Select Education"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="10dp"
                                android:background="@null"
                                android:fontFamily="@font/montserrat_regular"
                                android:hint="@string/selectDetails"
                                android:imeOptions="actionNext"
                                android:nextFocusDown="@+id/fname"
                                android:paddingRight="10dp"
                                android:singleLine="true"
                                android:textColor="@color/black1" />
                        </RelativeLayout>

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_semibold"
                            android:text="@string/current_activityDetails" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_gravity="center|bottom"
                            android:layout_weight="1"
                            android:background="@drawable/border"
                            android:gravity="center|bottom"
                            android:textAlignment="center">

                            <com.krs.community.jrspinner.JRSpinner
                                android:id="@+id/sp_current_activity"
                                app:backgroundTint="@color/colorPrimary"
                                app:jrs_icon_tint="@color/colorPrimary"
                                app:jrs_multiple="false"
                                app:jrs_title="Select Current Activity"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="10dp"
                                android:background="@null"
                                android:fontFamily="@font/montserrat_regular"
                                android:hint="@string/selectDetails"
                                android:imeOptions="actionNext"
                                android:nextFocusDown="@+id/fname"
                                android:paddingRight="10dp"
                                android:singleLine="true"
                                android:textColor="@color/black1" />
                        </RelativeLayout>

                    </LinearLayout>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_semibold"
                            android:text="@string/marital_statusDetails" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_gravity="center|bottom"
                            android:layout_weight="1"
                            android:background="@drawable/border"
                            android:gravity="center|bottom"
                            android:textAlignment="center">

                            <com.krs.community.jrspinner.JRSpinner
                                android:id="@+id/sp_marital"
                                app:backgroundTint="@color/colorPrimary"
                                app:jrs_icon_tint="@color/colorPrimary"
                                app:jrs_multiple="false"
                                app:jrs_title="Select Blood Group"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="10dp"
                                android:background="@null"
                                android:fontFamily="@font/montserrat_regular"
                                android:hint="@string/selectDetails"
                                android:imeOptions="actionNext"
                                android:nextFocusDown="@+id/fname"
                                android:paddingRight="10dp"
                                android:singleLine="true"
                                android:textColor="@color/black1" />
                        </RelativeLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_marginLeft="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_semibold"
                                android:text="@string/marriage_dateDetails" />

                            <TextView
                                android:id="@+id/txt_mdate"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:textSize="18sp"
                                android:paddingLeft="10dp"
                                android:gravity="center_vertical"
                                android:background="@drawable/border_color_gray"
                                android:fontFamily="@font/montserrat_regular"
                                android:singleLine="true" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_regular"
                            android:text="DD/MM/YYYY"
                            android:textSize="10sp" />

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/local_address_if_anyDetails"
                        android:fontFamily="@font/montserrat_semibold" />



                    <EditText
                        android:id="@+id/edt_local_addr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border_color_gray"
                        android:padding="5dp"
                        android:inputType="textMultiLine"
                        android:lines="2"
                        android:gravity="top|left"
                        android:maxLines="2"
                        android:minLines="2"
                        android:fontFamily="@font/montserrat_regular"
                        android:scrollbars="vertical"
                        android:singleLine="true" />

                </LinearLayout>


            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</layout>